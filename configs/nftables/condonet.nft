destroy table ip condonet

table ip condonet {
    set lan_networks {
        type ipv4_addr
        flags interval
        elements = { 10.60.10.0/24, 10.60.20.0/24, 10.60.30.0/24, 10.60.40.0/24, 10.60.50.0/24 }
    }

    set gateway_addresses {
        type ipv4_addr
        elements = { 10.60.10.1, 10.60.20.1, 10.60.30.1, 10.60.40.1, 10.60.50.1, 10.60.254.1 }
    }

    set quarantine {
        type ipv4_addr
        flags timeout
        timeout 120s
    }

    counter quarantine_input {}
    counter quarantine_forward {}
    counter invalid_drop {}
    counter source_drop {}
    counter input_established {}
    counter forward_established {}
    counter input_drop {}
    counter forward_drop {}
    counter dhcp_allow {}
    counter gateway_icmp_allow {}
    counter gateway_ssh_allow {}
    counter lab_icmp_allow {}
    counter svc_ssh_allow {}
    counter dns_allow {}
    counter portal_allow {}
    counter camera_allow {}
    counter wan_http_allow {}
    counter wan_nat {}

    chain validate_source {
        iifname "eth1.10" ip saddr 10.60.10.0/24 return
        iifname "eth1.20" ip saddr 10.60.20.0/24 return
        iifname "eth1.30" ip saddr 10.60.30.0/24 return
        iifname "eth1.40" ip saddr 10.60.40.0/24 return
        iifname "eth1.50" ip saddr 10.60.50.0/24 return
        iifname "eth2" ip saddr 10.60.254.2 return
        counter name source_drop drop
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state invalid counter name invalid_drop drop
        iifname "lo" accept
        iifname { "eth1.20", "eth1.30" } ip saddr 0.0.0.0 ip daddr 255.255.255.255 udp sport 68 udp dport 67 counter name dhcp_allow accept
        jump validate_source
        ip saddr @quarantine counter name quarantine_input drop
        iifname { "eth1.20", "eth1.30" } ip daddr 255.255.255.255 udp sport 68 udp dport 67 counter name dhcp_allow accept
        iifname . ip daddr { "eth1.20" . 10.60.20.1, "eth1.30" . 10.60.30.1 } udp sport 68 udp dport 67 counter name dhcp_allow accept
        ct state established,related counter name input_established accept
        iifname "eth1.10" ip daddr 10.60.10.1 tcp dport 22 ct state new counter name gateway_ssh_allow accept
        iifname "eth1.10" ip daddr @gateway_addresses icmp type echo-request counter name gateway_icmp_allow accept
        iifname . ip daddr { "eth1.20" . 10.60.20.1, "eth1.30" . 10.60.30.1, "eth1.40" . 10.60.40.1 } icmp type echo-request counter name gateway_icmp_allow accept
        counter name input_drop drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid counter name invalid_drop drop
        jump validate_source
        ip saddr @quarantine counter name quarantine_forward drop
        ip daddr @quarantine counter name quarantine_forward drop
        ct state established,related counter name forward_established accept
        iifname "eth1.10" oifname { "eth1.20", "eth1.30", "eth1.40", "eth1.50" } ip daddr @lan_networks icmp type echo-request counter name lab_icmp_allow accept
        iifname "eth1.10" oifname "eth2" ip daddr 10.60.254.2 icmp type echo-request counter name lab_icmp_allow accept
        iifname "eth1.10" oifname "eth1.50" ip daddr 10.60.50.10 tcp dport 22 ct state new counter name svc_ssh_allow accept
        iifname { "eth1.10", "eth1.20", "eth1.30", "eth1.40" } oifname "eth1.50" ip daddr 10.60.50.10 meta l4proto { tcp, udp } th dport 53 ct state new counter name dns_allow accept
        iifname { "eth1.10", "eth1.20" } oifname "eth1.50" ip daddr 10.60.50.10 tcp dport 80 ct state new counter name portal_allow accept
        iifname "eth1.10" oifname "eth1.40" ip daddr 10.60.40.10 tcp dport 80 ct state new counter name camera_allow accept
        iifname { "eth1.10", "eth1.20", "eth1.30" } oifname "eth2" ip daddr 10.60.254.2 tcp dport 80 ct state new counter name wan_http_allow accept
        counter name forward_drop drop
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "eth2" ip saddr { 10.60.10.0/24, 10.60.20.0/24, 10.60.30.0/24 } ip daddr 10.60.254.2 tcp dport 80 counter name wan_nat masquerade
    }
}
