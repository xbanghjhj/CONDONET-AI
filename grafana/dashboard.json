      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(condonet_availability{job=\"condonet\",source_node=~\"$source\"} and on(source_node,service,probe) (time() - condonet_probe_sample_timestamp_seconds{job=\"condonet\",source_node=~\"$source\"} <= 25)) and on(job) (up{job=\"condonet\"} == 1)",
          "instant": false,
          "range": true,
          "legendFormat": "{{source_node}} · {{service}} · {{probe}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        }
      }
    },
