{
  "uid": "condonet-day04",
  "title": "CondoNet Lab Observability",
  "tags": [
    "condonet",
    "observability"
  ],
  "schemaVersion": 41,
  "editable": false,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "condonet-prometheus"
        },
        "definition": "label_values(condonet_probe_sample_present, source_node)",
        "query": {
          "query": "label_values(condonet_probe_sample_present, source_node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Portal availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "condonet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(condonet_availability{job=\"condonet\",source_node=~\"$source\",service=\"portal\",probe=\"http\"} and on(source_node,service,probe) (time() - condonet_probe_sample_timestamp_seconds{job=\"condonet\",source_node=~\"$source\",service=\"portal\",probe=\"http\"} <= 25)) and on(job) (up{job=\"condonet\"} == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Web down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Collector scrape",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "condonet-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"condonet\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Collector down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Scrape up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Missing or stale probes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "condonet-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((1 - condonet_probe_sample_present{job=\"condonet\",source_node=~\"$source\"}) and on(job) (up{job=\"condonet\"} == 1))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "All samples present",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "condonet-prometheus"
