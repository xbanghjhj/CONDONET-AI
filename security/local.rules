alert tcp 10.60.20.0/24 any -> 10.60.50.10 80 (msg:"CondoNet resident portal flow marker"; vlan.id:20; flags:S; flowbits:set,condonet_resident_portal; flowbits:noalert; sid:1000003; rev:1;)
